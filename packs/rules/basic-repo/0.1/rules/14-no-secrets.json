{
  "schema": "bumao.rule/v1",
  "rule_id": "basic-repo/no-secrets",
  "title": "No secret-looking strings are committed",
  "severity": "blocker",
  "check": {
    "type": "no_secrets",
    "max_scan_bytes": 1048576,
    "patterns": [
      {
        "kind": "AWS access key ID",
        "regex": "AKIA[0-9A-Z]{16}"
      },
      {
        "kind": "private key block",
        "regex": "-----BEGIN [A-Z ]{0,12}PRIVATE KEY-----"
      },
      {
        "kind": "GitHub token",
        "regex": "gh[pousr]_[A-Za-z0-9]{36}"
      },
      {
        "kind": "credential assignment",
        "regex": "(?:api[_-]?key|secret|access[_-]?token)\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-]{20,}[\"']"
      }
    ]
  },
  "message": "Possible {kind} in {path} at line {line}; remove it and rotate the credential if it was real."
}
