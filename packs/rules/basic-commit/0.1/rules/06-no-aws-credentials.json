{
  "schema": "bumao.rule/v1",
  "rule_id": "basic-commit/no-aws-credentials",
  "title": "No AWS access key or secret is committed",
  "severity": "blocker",
  "check": {
    "type": "no_secrets",
    "max_scan_bytes": 1048576,
    "patterns": [
      {
        "kind": "AWS access key ID",
        "regex": "AKIA[0-9A-Z]{16}"
      },
      {
        "kind": "AWS secret access key",
        "regex": "aws_secret_access_key\\s*[:=]\\s*[\"'][A-Za-z0-9/+=]{20,}[\"']"
      }
    ]
  },
  "message": "Possible {kind} in {path} at line {line}; remove it from the commit and rotate the credential if it was real."
}
